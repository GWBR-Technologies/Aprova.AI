// Grafana Alloy: raspa as métricas internas e lê os logs dos contêineres do projeto aprovaai.
// Nenhum token fica neste arquivo: URLs, usuários e o token vêm de /opt/aprova/secrets/alloy.env
// (infra/env/alloy.env.example). Os valores são os do assistente de integração do Grafana Cloud.

// ---------- Métricas ----------

prometheus.remote_write "grafana_cloud" {
  external_labels = {
    env = "production",
  }

  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")

    basic_auth {
      username = sys.env("GRAFANA_METRICS_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// Rede de segurança contra a explosão de séries (plano gratuito: 10 mil séries): identificadores de
// usuário, comando ou redação jamais viram rótulo de métrica.
prometheus.relabel "guard_cardinality" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    action = "labeldrop"
    regex  = "(?i)(user_?id|command_?id|essay_?id|correlation_?id)"
  }
}

// API e Workers expõem as métricas em METRICS_PORT, só na rede interna do Compose.
prometheus.scrape "app" {
  targets = [
    {"__address__" = "api:" + sys.env("METRICS_PORT"), "service" = "api"},
    {"__address__" = "worker:" + sys.env("METRICS_PORT"), "service" = "worker"},
  ]
  job_name        = "aprova-app"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.guard_cardinality.receiver]
}

prometheus.scrape "host_redis_postgres" {
  targets = [
    {"__address__" = "node-exporter:9100", "service" = "host"},
    {"__address__" = "redis-exporter:9121", "service" = "redis"},
    {"__address__" = "postgres-exporter:9187", "service" = "postgres"},
  ]
  job_name        = "aprova-infra"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.guard_cardinality.receiver]
}

// ---------- Logs ----------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Só os contêineres do projeto Compose, com o nome do serviço como rótulo.
discovery.relabel "aprova" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "aprovaai"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "aprova" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.aprova.output
  labels     = {"env" = "production"}
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOGS_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
