# Copiar para /opt/aprova/secrets/backup.env (modo 600). Opcional.
# Remoto do rclone para a cópia fora da VM, configurado com `rclone config` pelo usuário deploy
# (as credenciais ficam em ~/.config/rclone/rclone.conf na VM, nunca no repositório).
# Exemplo: BACKUP_RCLONE_REMOTE=oci:aprova-backups
BACKUP_RCLONE_REMOTE=
