# Copiar para /opt/aprova/secrets/alloy.env (modo 600). Os valores vêm do assistente de integração do Grafana Cloud
# (Connections); o token é criado no próprio Grafana Cloud com escopo de escrita de métricas e logs.
GRAFANA_METRICS_URL=<url de escrita de métricas (Prometheus remote write)>
GRAFANA_METRICS_USER=<id numérico da instância de métricas>
GRAFANA_LOGS_URL=<url de escrita de logs (Loki)>
GRAFANA_LOGS_USER=<id numérico da instância de logs>
GRAFANA_CLOUD_TOKEN=<token de acesso>
# Mesma porta de common.env.
METRICS_PORT=9464
