# Copiar para /opt/aprova/secrets/common.env (modo 600) e preencher. Somente nomes e valores não sensíveis ficam aqui.
# Lido por api, worker, relay e migrate. Senhas embutidas em URL: use `openssl rand -hex 32` (base64 traz / e + que quebram a URL).
NODE_ENV=production
LOG_LEVEL=info
# Porta interna de métricas (rede do Compose); o Caddy nunca a publica.
METRICS_PORT=9464
REDIS_URL=redis://:<senha-do-redis>@redis:6379
# Segredo: `openssl rand -base64 48`.
JWT_SECRET=<gerar>
# Valores sugeridos pelo Back-End; públicos, não são segredo.
JWT_ISSUER=aprovaai-api
JWT_AUDIENCE=aprovaai-app
GOOGLE_CLIENT_IDS=<definir>
APPLE_CLIENT_ID=<definir>
SENTRY_DSN=<dsn do projeto no Sentry>
ESSAY_MONTHLY_LIMIT=4
# Definido pelo produto; sem padrão.
ESSAY_MAX_CHARS=
