# Copiar para /opt/aprova/secrets/worker.env (modo 600). OPENAI_API_KEY existe somente neste arquivo.
DATABASE_URL=postgres://<papel-worker>:<senha-do-papel>@postgres:5432/aprovaai
OPENAI_API_KEY=<chave da IA>
AI_MODEL=<identificador confirmado na documentação da API>
# Deve ser menor que o stop_grace_period do worker em compose.yml (150 s).
AI_TIMEOUT_MS=
AI_PRICE_INPUT_PER_M=1.00
AI_PRICE_CACHED_INPUT_PER_M=0.05
AI_PRICE_OUTPUT_PER_M=5.00
# Opcional: freio orçamentário mensal.
AI_MONTHLY_BUDGET_USD=
ESSAY_WORKER_CONCURRENCY=
