# Copiar para /opt/aprova/secrets/worker.env (modo 600). OPENAI_API_KEY existe somente neste arquivo.
# Login criado por infra/scripts/create-db-logins.sh no grupo aprova_worker; a senha deve ser hexadecimal.
DATABASE_URL=postgres://aprova_worker_login:<senha-hex>@postgres:5432/aprovaai
OPENAI_API_KEY=<chave da IA>
AI_MODEL=<identificador confirmado na documentação da API>
# Deve ser menor que o stop_grace_period do worker em compose.yml (150 s); o Back-End propõe até 120000.
AI_TIMEOUT_MS=120000
# Sem ela o Worker não consome a fila de correção e as redações ficam na fila.
AI_PROMPT_VERSION=
AI_PRICE_INPUT_PER_M=1.00
AI_PRICE_CACHED_INPUT_PER_M=0.05
AI_PRICE_OUTPUT_PER_M=5.00
# Opcional: freio orçamentário mensal.
AI_MONTHLY_BUDGET_USD=
ESSAY_WORKER_CONCURRENCY=
ESSAY_RATE_LIMIT_PER_MIN=
