{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@contracts/*": ["../contracts/*"] }
  },
  "include": ["src", "test", "../contracts", "drizzle.config.ts", "vitest.config.ts"]
}
