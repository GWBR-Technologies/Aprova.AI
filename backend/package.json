{
  "name": "aprovaai-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --watch src/bootstrap/api.ts",
    "start:api": "node src/bootstrap/api.ts",
    "start:worker": "node src/bootstrap/worker.ts",
    "start:relay": "node src/bootstrap/relay.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/bootstrap/migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "bullmq": "6.5.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
